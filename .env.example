# Copy this file to .env and fill in your key.  NEVER commit .env to GitHub.

# Option A (default): Groq - free tier, get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=your-key-here

# Option B: run a model locally with Ollama (free, no key). Install Ollama, run `ollama pull llama3.2`, then:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=

# Option C: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<a current model name from the OpenAI docs>
# LLM_API_KEY=sk-...
